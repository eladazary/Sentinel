# ---- Sentinel environment (copy to .env) ----

# Operating mode. Phase 0 only ever reads market data; nothing trades.
SENTINEL_MODE=DRY_RUN

# --- Datastores (defaults match docker-compose service names) ---
SENTINEL_DATABASE_URL=postgresql+psycopg://sentinel:sentinel@timescaledb:5432/sentinel
SENTINEL_REDIS_URL=redis://redis:6379/0

# --- Alpaca market data ---
# Create keys at https://app.alpaca.markets (paper account is fine for data).
SENTINEL_ALPACA_API_KEY=
SENTINEL_ALPACA_SECRET_KEY=
# Free accounts get the IEX feed; SIP requires a paid data plan.
SENTINEL_ALPACA_DATA_FEED=iex

# --- Ingestion behaviour ---
SENTINEL_BACKFILL_YEARS=5
SENTINEL_INGEST_INTERVAL_SECONDS=60

# --- Misc ---
SENTINEL_WATCHLIST_PATH=config/watchlist.yaml
SENTINEL_LOG_LEVEL=INFO
