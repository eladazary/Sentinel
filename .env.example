# ---- Sentinel environment (copy to .env) ----

# Operating mode. Phase 0 only ever reads market data; nothing trades.
SENTINEL_MODE=DRY_RUN

# --- Datastores (defaults match docker-compose service names) ---
SENTINEL_DATABASE_URL=postgresql+psycopg://sentinel:sentinel@timescaledb:5432/sentinel
SENTINEL_REDIS_URL=redis://redis:6379/0

# --- Alpaca market data ---
# Create keys at https://app.alpaca.markets (paper account is fine for data).
SENTINEL_ALPACA_API_KEY=
SENTINEL_ALPACA_SECRET_KEY=
# Free accounts get the IEX feed; SIP requires a paid data plan.
SENTINEL_ALPACA_DATA_FEED=iex

# --- Ingestion behaviour ---
SENTINEL_BACKFILL_YEARS=5
SENTINEL_INGEST_INTERVAL_SECONDS=60

# --- Phase 2: news & social sentiment ---
# Sentiment scorer: finbert (local, offline), claude (API), or lexicon.
SENTINEL_SENTIMENT_ENGINE=finbert
# Claude API powers news event-classification (falls back to rules if unset).
SENTINEL_ANTHROPIC_API_KEY=
# SEC EDGAR requires a descriptive User-Agent with real contact info.
SENTINEL_SEC_USER_AGENT=Sentinel/0.1 (contact: you@example.com)
# Finnhub news + earnings calendar (free tier): https://finnhub.io
SENTINEL_FINNHUB_API_KEY=
# Reddit app (script type) credentials: https://www.reddit.com/prefs/apps
SENTINEL_REDDIT_CLIENT_ID=
SENTINEL_REDDIT_CLIENT_SECRET=
# StockTwits + SEC EDGAR need no keys and are always on.

# --- Misc ---
SENTINEL_WATCHLIST_PATH=config/watchlist.yaml
SENTINEL_LOG_LEVEL=INFO

# Set false to lift the spec §6 daily new-position cap (1/2/4 by risk factor).
SENTINEL_ENFORCE_DAILY_POSITION_CAP=true
